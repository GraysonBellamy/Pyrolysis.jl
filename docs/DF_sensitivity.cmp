EMISSIVITY & ABSORPTION:  0.81  1000

COMPONENT:	INERT
STATE:	S
DENSITY: 1 0 0 0
HEAT CAPACITY: 1 0 0 0
CONDUCTIVITY: 1e5 0 0 0
TRANSPORT: 1e-30 0 0 0
EMISSIVITY & ABSORPTION: 0 1000000

MIXTURES
S SWELLING:		0
L SWELLING:		0
G SWELLING LIMIT:	1e-30
PARALL CONDUCTIVITY:	0.5
PARALL TRANSPORT:	0.5

// --- Piecewise cp transitions for virgin DF ---
REACTION:	DF + NOCOMP -> DF_M + NOCOMP
STOICHIOMETRY:  1 0 1 0
ARRHENIUS:      1 0
HEAT:		0  0  0  0
TEMP LIMIT:	L 323

REACTION:	DF_M + NOCOMP -> DF_H + NOCOMP
STOICHIOMETRY:  1 0 1 0
ARRHENIUS:      1 0
HEAT:		0  0  0  0
TEMP LIMIT:	L 425

// --- Moisture evaporation ---
REACTION:	MOISTURE + NOCOMP -> NOCOMP + WATER_VAPOR
STOICHIOMETRY:  1 0 0 1
ARRHENIUS:      299700 50000
HEAT:		-3.088E6  0  0  0
TEMP LIMIT:	L 290

// --- Pyrolysis (consumes DF_H, the high-T variant) ---
REACTION:	DF_H + NOCOMP -> DF_INT1 + DF_GAS1
STOICHIOMETRY:  1 0 0.95 0.05
ARRHENIUS:      74816.95 71590
HEAT:		1.920E4  0  0  0
TEMP LIMIT:	L 378

