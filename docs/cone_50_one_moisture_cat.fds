&HEAD CHID='cone_50_one_moisture_cat', TITLE='(Concatenated) ' /
&MESH ID='MESH1', IJK=3,1,3, XB=0.0,0.03,  0.0,0.01,  0.0,0.007 /

&MISC SOLID_PHASE_ONLY=.TRUE., TMPA=56.85 /

&TIME T_END=1000, WALL_INCREMENT=1, DT=0.001 /

&SPEC ID = 'METHANE' /

# Start of file df_sii_one_moisture.fds :
&MATL ID = 'DF', DENSITY = 530, EMISSIVITY = 0.9, CONDUCTIVITY = 0.12, N_REACTIONS = 1, A(1) = 74816.9500511, E(1) = 71.59e+3, SPEC_ID = 'METHANE', NU_SPEC = 0.05, NU_MATL = 0.95, MATL_ID = 'DF_int1', SPECIFIC_HEAT_RAMP = 'c_v', HEAT_OF_REACTION = -20.07, ABSORPTION_COEFFICIENT=50000.0 /

&MATL ID = 'DF_int1', DENSITY = 507.2, EMISSIVITY = 0.9, CONDUCTIVITY = 0.14, N_REACTIONS = 1, A(1) = 23550492839, E(1) = 140.9e+3, SPEC_ID = 'METHANE', NU_SPEC = 0.20, NU_MATL = 0.80, MATL_ID = 'DF_int2', SPECIFIC_HEAT_RAMP = 'c_int1', HEAT_OF_REACTION = -8.264, ABSORPTION_COEFFICIENT=50000.0 /

&MATL ID = 'DF_int2', DENSITY = 419.8, EMISSIVITY = 0.9, CONDUCTIVITY = 0.15, N_REACTIONS = 1, A(1) = 7.744618e+12, E(1) = 181.0e+3, SPEC_ID = 'METHANE', NU_SPEC = 0.63, NU_MATL = 0.37, MATL_ID = 'DF_int3', SPECIFIC_HEAT_RAMP = 'c_int2', HEAT_OF_REACTION = 273.999, ABSORPTION_COEFFICIENT=50000.0 /

&MATL ID = 'DF_int3', DENSITY = 203.2, EMISSIVITY = 0.9, CONDUCTIVITY = 0.16, N_REACTIONS = 1, A(1) = 103276.140576, E(1) = 98.94e+3, SPEC_ID = 'METHANE', NU_SPEC = 0.21, NU_MATL = 0.79, MATL_ID = 'DF_int4', SPECIFIC_HEAT_RAMP = 'c_int3', HEAT_OF_REACTION = -224.43,ABSORPTION_COEFFICIENT=50000.0 /

&MATL ID = 'DF_int4', DENSITY = 176.6, EMISSIVITY = 0.9, CONDUCTIVITY = 0.18, N_REACTIONS = 1, A(1) = 6.39734835483, E(1) = 56.01e+3, SPEC_ID = 'METHANE', NU_SPEC = 0.26, NU_MATL = 0.74, MATL_ID = 'DF_char', SPECIFIC_HEAT_RAMP = 'c_int4', HEAT_OF_REACTION = 0.556, ABSORPTION_COEFFICIENT=50000.0 /

&MATL ID = 'DF_char', DENSITY = 150, EMISSIVITY = 0.95, CONDUCTIVITY = 0.20, SPECIFIC_HEAT_RAMP = 'c_char', ABSORPTION_COEFFICIENT=50000.0 /

&SPEC ID='WATER VAPOR' /

&MATL ID            = 'MOISTURE_1'
      DENSITY       = 100000.
	  EMISSIVITY	= 0.9
      SPECIFIC_HEAT = 4.18
      CONDUCTIVITY  = 0.6
      N_REACTIONS   = 1
      A(1)          = 2.997E+05
      E(1)          = 5.00E+04
      SPEC_ID(1,1)  = 'WATER VAPOR'
      NU_SPEC(1,1)  = 1.0
      HEAT_OF_REACTION(1) = 2674.
	  ABSORPTION_COEFFICIENT=50000.0	  /
	
&RAMP ID='c_v', T=0., F=1.106 /
&RAMP ID='c_v', T=50., F=1.318 /
&RAMP ID='c_v', T=152., F=1.744 /
&RAMP ID='c_v', T=1000., F=9.479 /

&RAMP ID='c_int1', T=0., F=0.3934 /
&RAMP ID='c_int1', T=1000., F=9.093 /

&RAMP ID='c_int2', T=0., F=0.493 /
&RAMP ID='c_int2', T=1000., F=7.493 /

&RAMP ID='c_int3', T=0., F=0.766 /
&RAMP ID='c_int3', T=1000., F=3.566 /

&RAMP ID='c_int4', T=0., F=0.804 /
&RAMP ID='c_int4', T=1000., F=3.104 /

&RAMP ID='c_char', T=0., F=0.835 /
&RAMP ID='c_char', T=1000., F=2.619 /

&SURF ID='DF_TOP'
  MATL_ID(1,1:7)='DF','DF_int1','DF_int2','DF_int3','DF_int4','DF_char','MOISTURE_1'
  MATL_MASS_FRACTION(1,1:7)=0.8696,0,0,0,0,0,0.1304
  THICKNESS(1)=0.012
  BACKING='INSULATED'
  EXTERNAL_FLUX=50       ! kW/m2
  HEAT_TRANSFER_COEFFICIENT=7.2
  TMP_INNER=26.85
  TMP_GAS_FRONT=56.85         ! 330 K in °C (losses)
  CELL_SIZE(1)=5.0E-5 /

&VENT XB=0.0,0.03, 0.0,0.01, 0.0,0.0 SURF_ID='DF_TOP' /

&VENT XB=0.0,0.0,  0.0,0.01, 0.0,0.007 SURF_ID='OPEN' /
&VENT XB=0.03,0.03,0.0,0.01, 0.0,0.007 SURF_ID='OPEN' /
&VENT XB=0.0,0.03, 0.0,0.01, 0.007,0.007 SURF_ID='OPEN' /

&DUMP DT_DEVC = 1, SUPPRESS_DIAGNOSTICS = .TRUE. /

&DEVC ID='temp_face', QUANTITY='WALL TEMPERATURE',
      XYZ=0.015,0.005,0.0, IOR=3 /
	
&DEVC ID='temp_back', QUANTITY='INSIDE WALL TEMPERATURE', DEPTH=-0.0
      XYZ=0.015,0.005,0.0, IOR=3 /
	
&DEVC ID='temp_3mm_from_back', QUANTITY='INSIDE WALL TEMPERATURE', DEPTH=-0.003
      XYZ=0.015,0.005,0.0, IOR=3 /

&DEVC ID='conv_face', QUANTITY='CONVECTIVE HEAT FLUX',
      XYZ=0.015,0.005,0.0, IOR=3 /

&DEVC ID='thick_face', QUANTITY='WALL THICKNESS',
      XYZ=0.015,0.005,0.0, IOR=3 /

&DEVC ID='nMass', QUANTITY='NORMALIZED MASS',
      XYZ=0.015,0.005,0.0, IOR=3 /

&DEVC ID='METHANE_MF', QUANTITY='MASS FLUX', SPEC_ID='METHANE',
      XYZ=0.015,0.005,0.0, IOR=3 /

&DEVC ID='WATER_MF', QUANTITY='MASS FLUX', SPEC_ID='WATER VAPOR',
      XYZ=0.015,0.005,0.0, IOR=3 /
	
&DEVC XYZ = 0.015,0.005,0.0, IOR = 3, QUANTITY = 'SURFACE DENSITY', MATL_ID = 'DF', ID = 'DF Density' /
&DEVC XYZ = 0.015,0.005,0.0, IOR = 3, QUANTITY = 'SURFACE DENSITY', MATL_ID = 'DF_int1', ID = 'DF_int1 Density' /
&DEVC XYZ = 0.015,0.005,0.0, IOR = 3, QUANTITY = 'SURFACE DENSITY', MATL_ID = 'DF_int2', ID = 'DF_int2 Density' /
&DEVC XYZ = 0.015,0.005,0.0, IOR = 3, QUANTITY = 'SURFACE DENSITY', MATL_ID = 'DF_int3', ID = 'DF_int3 Density' /
&DEVC XYZ = 0.015,0.005,0.0, IOR = 3, QUANTITY = 'SURFACE DENSITY', MATL_ID = 'DF_int4', ID = 'DF_int4 Density' /
&DEVC XYZ = 0.015,0.005,0.0, IOR = 3, QUANTITY = 'SURFACE DENSITY', MATL_ID = 'DF_char', ID = 'Char Density' /
&DEVC XYZ = 0.015,0.005,0.0, IOR = 3, QUANTITY = 'SURFACE DENSITY', MATL_ID = 'MOISTURE_1', ID = 'Moisture 1 Density' /


&TAIL /
