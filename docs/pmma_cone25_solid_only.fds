&HEAD CHID='pmma_cone_25kW_backloss', TITLE='PMMA cone-style pyrolysis with backside heat losses' /

! -----------------------------------------------------------------------------
! Mesh / time control
! -----------------------------------------------------------------------------
&MESH IJK=6,6,8, XB=-0.10,0.10,-0.10,0.10, 0.0,0.12 /

&TIME T_END=1600., DT=0.05 /
&MISC SOLID_PHASE_ONLY=T TMPA=27. /

! Open boundaries
&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

! -----------------------------------------------------------------------------
! Species created by pyrolysis
! -----------------------------------------------------------------------------
&SPEC ID='MMA', MW=100.12 /

! -----------------------------------------------------------------------------
! Temperature-dependent PMMA thermal properties (approx. from your Julia piecewise)
! cp in FDS is kJ/(kg*K); k is W/(m*K); T on RAMP is °C
! -----------------------------------------------------------------------------
&RAMP ID='c_pmma', T=  27., F=1.07 /
&RAMP ID='c_pmma', T= 105., F=1.94 /
&RAMP ID='c_pmma', T= 106., F=2.20 /
&RAMP ID='c_pmma', T= 327., F=2.89 /

&RAMP ID='k_pmma', T=  27., F=0.15 /
&RAMP ID='k_pmma', T= 105., F=0.15 /
&RAMP ID='k_pmma', T= 106., F=0.193 /
&RAMP ID='k_pmma', T= 327., F=0.106 /

! -----------------------------------------------------------------------------
! Materials
! -----------------------------------------------------------------------------
&MATL ID='PMMA_CHAR'
  DENSITY=1210.
  EMISSIVITY=0.95
  SPECIFIC_HEAT_RAMP='c_pmma'
  CONDUCTIVITY_RAMP='k_pmma'
  ABSORPTION_COEFFICIENT=1800. /

&MATL ID='PMMA'
  DENSITY=1210.
  EMISSIVITY=0.96
  SPECIFIC_HEAT_RAMP='c_pmma'
  CONDUCTIVITY_RAMP='k_pmma'
  ABSORPTION_COEFFICIENT=1800.
  N_REACTIONS=1
  A(1)=1.5E14
  E(1)=203000.
  HEAT_OF_REACTION(1)=820.
  SPEC_ID(1,1)='MMA'
  NU_SPEC(1,1)=0.998
  MATL_ID(1,1)='PMMA_CHAR'
  NU_MATL(1,1)=0.002 /

! -----------------------------------------------------------------------------
! Surfaces
! -----------------------------------------------------------------------------
! TOP (exposed) surface: external cone flux + losses to T_inf=330K (≈56.85°C)
&SURF ID='PMMA_SAMPLE',
      MATL_ID='PMMA',
      THICKNESS=0.0058,
      BACKING='VOID',

      EXTERNAL_FLUX=24.53,
      TMP_GAS_FRONT=57.0,
      HEAT_TRANSFER_COEFFICIENT=7.2,
      EMISSIVITY=0.96,

      TMP_GAS_BACK=33.85,
      HEAT_TRANSFER_COEFFICIENT_BACK=4.0,
      EMISSIVITY_BACK=0.95 /

! -----------------------------------------------------------------------------
! Geometry: make a thin OBST slab so we can apply TOP and BOTTOM surfaces separately
! -----------------------------------------------------------------------------
! 100 mm x 100 mm x 5.8 mm slab sitting on z=0
&OBST ID='PMMA_SAMPLE', XB=-0.05,0.05,-0.05,0.05, 0.0,0.0058,
      SURF_ID='PMMA_SAMPLE' /

! NOTE:
! - SURF_ID applies to the default faces; SURF_ID6 applies specifically to +Z face in FDS
!   If your FDS version uses SURF_ID(1:6)=... instead, swap accordingly.

! -----------------------------------------------------------------------------
! Output
! -----------------------------------------------------------------------------
&DUMP DT_DEVC=5., DT_BNDF=5. /

&DEVC ID='T_top', XYZ=0.0,0.0,0.0058, IOR=3, QUANTITY='WALL TEMPERATURE' /
&DEVC ID='T_bot', XYZ=0.0,0.0,0.0,    IOR=-3, QUANTITY='WALL TEMPERATURE' /
&DEVC ID='q_top', XYZ=0.0,0.0,0.0058, IOR=3, QUANTITY='TOTAL HEAT FLUX' /
&DEVC ID='q_bot', XYZ=0.0,0.0,0.0,    IOR=-3, QUANTITY='TOTAL HEAT FLUX' /
&DEVC XYZ = 0.0, 0.0, 0.0, IOR = 3, QUANTITY = 'NORMALIZED MASS LOSS RATE', SPEC_ID = 'MMA', ID = 'MMA_nMLR' /

&TAIL /
