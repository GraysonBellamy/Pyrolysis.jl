&HEAD CHID='vcpl03_shrink_swell_paths', TITLE='Pyrolysis.jl V-CPL-03: isothermal shrink/swell thickness paths' /

Replicates Pyrolysis.jl verification case V-CPL-03 permutations P1 and P2:
isothermal first-order conversion A -> B with rate constant 2 1/s (A=2, E=0),
no heating, no heat of reaction, L0 = 2 mm, insulated back.
Mesh 1 = P2 (shrink): rho 1000 -> 2000, exact L(t)/L0 = 1 - 0.5*(1 - e^(-2t)).
Mesh 2 = P1 (swell):  rho 1000 ->  500, exact L(t)/L0 = 1 + 1.0*(1 - e^(-2t)).
Adapted from FDS Verification/Pyrolysis/shrink_swell.fds (FDS-6.11.0).

&MESH IJK = 3,3,4, XB = 1.0,1.3,-0.15,0.15,0,0.4 /  Mesh 1: P2 shrink
&MESH IJK = 3,3,4, XB = 2.0,2.3,-0.15,0.15,0,0.4 /  Mesh 2: P1 swell

&TIME T_END=8. DT = 0.01 /
&MISC SOLID_PHASE_ONLY=.TRUE.,HUMIDITY=0., Y_O2_INFTY=0.01, Y_CO2_INFTY=0. /
&REAC FUEL='METHANE', CRITICAL_FLAME_TEMPERATURE=2000. /  No gas phase reaction
&DUMP DT_DEVC=0.1 /

&VENT MB='XMIN', SURF_ID='OPEN' /
&VENT MB='XMAX', SURF_ID='OPEN' /
&VENT MB='YMIN', SURF_ID='OPEN' /
&VENT MB='YMAX', SURF_ID='OPEN' /
&VENT MB='ZMAX', SURF_ID='OPEN' /

&VENT XB = 1.1,1.2,-0.05,0.05,0.0,0.0, SURF_ID = 'SHRINK_P2' /
&VENT XB = 2.1,2.2,-0.05,0.05,0.0,0.0, SURF_ID = 'SWELL_P1' /

&SURF ID             = 'SHRINK_P2'
      COLOR          = 'RED'
      BACKING        = 'INSULATED'
      EXTERNAL_FLUX  = 0.
      THICKNESS      = 0.002
      HEAT_TRANSFER_COEFFICIENT  = 0.
      MATL_ID(1,1)   = 'shrinking_P2'
      MATL_MASS_FRACTION(1,1) = 1.0 /

&SURF ID             = 'SWELL_P1'
      COLOR          = 'BLUE'
      BACKING        = 'INSULATED'
      EXTERNAL_FLUX  = 0.
      THICKNESS      = 0.002
      HEAT_TRANSFER_COEFFICIENT  = 0.
      MATL_ID(1,1)   = 'swelling_P1'
      MATL_MASS_FRACTION(1,1) = 1.0 /

&MATL ID                    = 'shrinking_P2'
      EMISSIVITY            = 0.
      DENSITY               = 1000.
      CONDUCTIVITY          = 0.20
      SPECIFIC_HEAT         = 1.0
      A                     = 2.0
      E                     = 0.
      NU_MATL               = 1.0
      MATL_ID               = 'product_P2'
      HEAT_OF_REACTION      = 0. /

&MATL ID                    = 'product_P2'
      EMISSIVITY            = 0.
      DENSITY               = 2000.
      CONDUCTIVITY          = 0.20
      SPECIFIC_HEAT         = 1.0 /

&MATL ID                    = 'swelling_P1'
      EMISSIVITY            = 0.
      DENSITY               = 1000.
      CONDUCTIVITY          = 0.20
      SPECIFIC_HEAT         = 1.0
      A                     = 2.0
      E                     = 0.
      NU_MATL               = 1.0
      MATL_ID               = 'product_P1'
      HEAT_OF_REACTION      = 0. /

&MATL ID                    = 'product_P1'
      EMISSIVITY            = 0.
      DENSITY               = 500.
      CONDUCTIVITY          = 0.20
      SPECIFIC_HEAT         = 1.0 /

&DEVC XYZ = 1.15,0.0,0.0,IOR = 3, QUANTITY = 'SURFACE DENSITY',  ID = 'M_P2' /
&DEVC XYZ = 1.15,0.0,0.0,IOR = 3, QUANTITY = 'WALL THICKNESS',   ID = 'L_P2' /
&DEVC XYZ = 2.15,0.0,0.0,IOR = 3, QUANTITY = 'SURFACE DENSITY',  ID = 'M_P1' /
&DEVC XYZ = 2.15,0.0,0.0,IOR = 3, QUANTITY = 'WALL THICKNESS',   ID = 'L_P1' /

&TAIL /
