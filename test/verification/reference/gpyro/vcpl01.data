! ============================================================================
! Gpyro v0.8200 deck replicating Pyrolysis.jl verification case V-CPL-01
! (Neumann two-phase Stefan problem via apparent heat capacity; Lautenberger
! dissertation Section 3.4.3, Eqs. 3.137-3.138, Fig. 3.11).
! Dissertation parameters, used verbatim by V-CPL-01.jl (route A):
! k=0.2 W/m-K, rho=900 kg/m3, c=1700 J/kg-K, Tm=433 K, DHm=50000 J/kg,
! Gaussian apparent-cp peak variance sigma_m^2=0.1 K^2 (Gpyro Eq. 3.5c via
! TMELT/DHMELT/SIGMA2MELT), T0=438 K, wall dropped to Tinf=428 K at t=0
! (TFIXED=428 pins the z=0 surface node - true Dirichlet).
! Deltas from V-CPL-01.jl: the Julia case uses a geometrically stretched
! mesh (Dz_top ~ 14 um); here the dissertation's uniform dz=0.05 mm and
! dt=0.02 s are used. Domain L=0.04 m matches the Julia case (semi-infinite
! surrogate). Adiabatic back. Inert (NRXNS=0); latent heat enters only
! through the analytic erf melt-enthalpy term in h(T).
! Output temperatures in deg C (Gpyro convention). PROFILE_ISKIP=2 (every
! other node, 0.1 mm) because Gpyro v0.8200 truncates profile rows at
! 10000 characters (801 nodes would overflow); the solve grid is unchanged.
! ============================================================================
&GPYRO_GENERAL
DT0 = 0.02,
TAMB = 300,
TREF = 300,
P0 = 101300,
GX = 0,
GZ = 0,
GY = 0,
THERMAL_EQUILIBRIUM = .TRUE.,
VHLC = 0,
HCV = 1000000,
NU_A = 2,
NU_B = 1,
NU_C = 0.5,
NTDMA_ITERATIONS = 2000,
NSSPECIESITERNS = 1,
NCONTINUITYITERNS = 1,
ALPHA = 1,
TMPTOL = 0.0001,
HTOL = 0.000000001,
YITOL = 0.0001,
PTOL = 0.0001,
YJTOL = 0.0001,
HGTOL = 0.1,
EXPLICIT_T = .FALSE.,
SOLVE_GAS_YJ = .FALSE.,
SOLVE_GAS_ENERGY = .FALSE.,
SOLVE_PRESSURE = .FALSE.,
USE_TOFH_NEWTON = .TRUE.,
SHYI_CORRECTION = .FALSE.,
NCOEFF_UPDATE_SKIP = 1,
FDSMODE = .FALSE.,
CONVENTIONAL_RXN_ORDER = .FALSE.,
NOCONSUMPTION = .FALSE.,
EPS = 0.0000000001,
BLOWING = .FALSE.,
CONSTANT_DHVOL = .TRUE.,
FULL_QSG = .FALSE.,
GASES_PRODUCED_AT_TSOLID = .FALSE.,
 /

&GPYRO_OUTPUT
CASENAME = 'vcpl01',
N_POINT_QUANTITIES = 2,
N_PROFILE_QUANTITIES = 1,
N_SMOKEVIEW_QUANTITIES = 0,
DTDUMP_GA = 1,
DTDUMP_POINT = 0.9995,
DTDUMP_PROFILE = 0.9995,
DTDUMP_SMOKEVIEW = 1000,
TMP_REDUCED_DTDUMP = 5000,
REDUCED_DTDUMP = 0.0001,
DTMIN_KILL = 0.0000001,
POINT_QUANTITY(1) = 'TEMPERATURE',
POINT_QUANTITY_INDEX(1) = 0,
POINT_IMESH(1) = 0,
POINT_Z(1) = 0.00001,
POINT_X(1) = 0,
POINT_Y(1) = 0,
POINT_QUANTITY(2) = 'TEMPERATURE',
POINT_QUANTITY_INDEX(2) = 0,
POINT_IMESH(2) = 0,
POINT_Z(2) = 0.03996,
POINT_X(2) = 0,
POINT_Y(2) = 0,
PROFILE_QUANTITY(1) = 'TEMPERATURE',
PROFILE_QUANTITY_INDEX(1) = 0,
PROFILE_DIRECTION(1) = 'z',
PROFILE_IMESH(1) = 0,
PROFILE_COORD1(1) = 0,
PROFILE_COORD2(1) = 0,
PROFILE_ISKIP(1) = 2,
 /

&GPYRO_SPROPS
NSSPEC = 1,
NAME(1) = 'polypropylene',
K0Z(1) = 0.2,
NKZ(1) = 0,
R0(1) = 900,
NR(1) = 0,
C0(1) = 1700,
NC(1) = 0,
EMIS(1) = 1,
KAPPA(1) = 9D9,
TMELT(1) = 433,
DHMELT(1) = 50000,
SIGMA2MELT(1) = 0.1,
GAMMA(1) = 0,
PERMZ(1) = 1D-10,
RS0(1) = 900,
PORE_DIAMETER(1) = 0.0005,
K0X(1) = 0.2,
NKX(1) = 0,
PERMX(1) = 1D-10,
K0Y(1) = 0.2,
NKY(1) = 0,
PERMY(1) = 1D-10,
 /

&GPYRO_RXNS
NRXNS = 0,
 /

&GPYRO_HGRXNS
NHGRXNS = 0,
 /

&GPYRO_GPROPS
NGSPEC = 1,
IBG = 1,
IO2 = 2,
CPG = 1000,
NAME(1) = 'pyrolysate' ,
M(1) = 44 ,
SIGMA(1) = 5.061 ,
EPSOK(1) = 254 ,
C0(1) = 1000 ,
NC(1) = 0 ,
 /

&GPYRO_GYIELDS
 /

&GPYRO_HGYIELDS
 /

&GPYRO_CASES
NCASES = 1,
IMESH(1) = 1,
TSTOP(1) = 300,
ZEROD(1) = .FALSE.,
BETA(1) = 0,
 /

&GA_GENINPUT NGEN = 200,
NINDIV = 500,
MAXCOPIES = 10,
SIMULATED_EXPERIMENTAL_DATA = .FALSE.,
RESTART = .FALSE.,
FITMIN = 0,
FITCLIP = 0,
FITEXPONENT = 2,
WHOLEGENEFRAC = 0.8,
BRUTE_FORCE = .FALSE.,
KILL_NONCONVERGED_SOLNS = .TRUE.,
ASA = 1,
BSA = 20,
OPTIMIZATION_TYPE = 'SCE',
ISOTROPIC_THERMAL_CONDUCTIVITY = .FALSE.,
ISOTROPIC_PERMEABILITY = .FALSE.,
DUMP_INTERMEDIATE_TRIALS = .FALSE.,
DUMP_ALL_RESULTS_BEST = .FALSE.,
MAXN = 1000000,
KSTOP = 100,
PCENTO = 0.00001,
NGS = 8,
ISEED = 1969,
NPG = 17,
NPS = 9,
NSPL = 17,
MINGS = 8,
NOPT = 8,
 /
&GPYRO_IC
NIC = 1,
TMP_INITIAL(1) = 438,
TMPG_INITIAL(1) = 438,
P_INITIAL(1) = 101300,
YI0(1,1) = 1,
YJ0(1,1) = 1,
 /

&GPYRO_ALLBC
NSURF_IDX = 2,
SURF_IDX(1) = 1,
T(1) = 0,
QE(1) = 0,
HC(1) = 0,
NHC(1) = 0,
TINF(1) = 428,
RERADIATION(1) = .FALSE.,
TFIXED(1) = 428,
MDOTPP(1) = 0,
PRES(1) = 101300,
QEG(1) = 0,
HCG(1) = 0,
TINFG(1) = 428,
TFIXEDG(1) = -1000,
HM(1) = 0,
YJINF(1,1) = 1,
SURF_IDX(2) = 2,
T(2) = 0,
QE(2) = 0,
HC(2) = 0,
NHC(2) = 0,
TINF(2) = 438,
RERADIATION(2) = .FALSE.,
TFIXED(2) = -1,
MDOTPP(2) = 0,
PRES(2) = -1000,
QEG(2) = 0,
HCG(2) = 0,
TINFG(2) = 438,
TFIXEDG(2) = -1000,
HM(2) = 0,
YJINF(2,1) = 1,
 /

&GPYRO_GEOM
NMESH = 1,
NOBST = 1,
ZDIM(1) = 0.04,
NCELLZ(1) = 801,
XDIM(1) = 1,
NCELLX(1) = 1,
YDIM(1) = 1,
NCELLY(1) = 1,
GEOMETRY_FILE(1) = 'null',
DEFAULT_SURF_IDX(1,1) = 0,
DEFAULT_SURF_IDX(1,2) = 0,
DEFAULT_SURF_IDX(1,3) = 0,
DEFAULT_SURF_IDX(1,4) = 0,
DEFAULT_SURF_IDX(1,5) = 1,
DEFAULT_SURF_IDX(1,6) = 2,
DEFAULT_IC(1) = 1,
OFFSETZ(1) = 0,
OFFSETX(1) = 0,
OFFSETY(1) = 0,
IMESH(1) = 1,
Z1(1) = 0,
Z2(1) = 0.04,
X1(1) = 0,
X2(1) = 1,
Y1(1) = 0,
Y2(1) = 1,
ICNUM(1) = 1,
SURF_IDX2D(1,1) = 0,
SURF_IDX2D(1,2) = 0,
SURF_IDX2D(1,3) = 0,
SURF_IDX2D(1,4) = 0,
SURF_IDX2D(1,5) = 1,
SURF_IDX2D(1,6) = 2,
HCR(1,1) = 9d9,
HCR(1,2) = 9d9,
HCR(1,3) = 9d9,
HCR(1,4) = 9d9,
HCR(1,5) = 9d9,
HCR(1,6) = 9d9,
 /

&GA_PHI
NPHI = 0,
 /

&GA_VARS
NGENE = 0,
 /
