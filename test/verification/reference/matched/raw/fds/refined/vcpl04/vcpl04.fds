&HEAD CHID='vcpl04', TITLE='Matched Pyrolysis.jl verification problem' /
&MESH IJK=3,3,3, XB=-0.15,0.15,-0.15,0.15,0,0.3 /
&TIME T_END=2500, DT=0.125, WALL_INCREMENT=1 /
&MISC SOLID_PHASE_ONLY=T, TMPA=226.85000000000002 /
&RADI RADIATION=F /
&DUMP DT_DEVC=125, DT_PROF=2500 /
&MATL ID='A', DENSITY=1000.0, SPECIFIC_HEAT=1.0, CONDUCTIVITY=0.2, EMISSIVITY=0.0, ADJUST_H=F, A=25892379352072200, E=166289.44000000003, N_S=0.0, NU_MATL=1, MATL_ID='A', HEAT_OF_REACTION=-100.0 /
&SURF ID='wall', MATL_ID='A', THICKNESS=0.02, STRETCH_FACTOR(1)=1, CELL_SIZE(1)=0.000125, HEAT_TRANSFER_COEFFICIENT=0, TMP_FRONT=226.85000000000002, TMP_BACK=226.85000000000002 /
&VENT XB=-0.05,0.05,-0.05,0.05,0,0, SURF_ID='wall' /
&PROF XYZ=0,0,0, IOR=3, QUANTITY='TEMPERATURE', CELL_CENTERED=T, FORMAT_INDEX=2, ID='temperature' /
&DEVC ID='front', XYZ=0,0,0, IOR=3, QUANTITY='WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='back', XYZ=0,0,0, IOR=3, QUANTITY='BACK WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='mean', XYZ=0,0,0, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE', TIME_AVERAGED=F, DEPTH=0.01 /
&DEVC ID='A', XYZ=0,0,0, IOR=3, QUANTITY='SOLID DENSITY', MATL_ID='A', DEPTH=0.01, TIME_AVERAGED=F /
&TAIL /
