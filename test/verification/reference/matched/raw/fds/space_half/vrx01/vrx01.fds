&HEAD CHID='vrx01', TITLE='Matched Pyrolysis.jl verification problem' /
&MESH IJK=3,3,3, XB=-0.15,0.15,-0.15,0.15,0,0.3 /
&TIME T_END=20, DT=0.00025000000000000001, WALL_INCREMENT=1 /
&MISC SOLID_PHASE_ONLY=T, TMPA=126.85000000000002 /
&RADI RADIATION=F /
&DUMP DT_DEVC=0.10000000000000001, DT_PROF=20 /
&MATL ID='A', DENSITY=1000.0, SPECIFIC_HEAT=1.0, CONDUCTIVITY=0.5, EMISSIVITY=0.0, A=0.38900000000000001, E=0, N_S=1, NU_MATL=1, MATL_ID='B', HEAT_OF_REACTION=0 /
&MATL ID='B', DENSITY=1000.0, SPECIFIC_HEAT=1.0, CONDUCTIVITY=0.5, EMISSIVITY=0.0, A=0.26200000000000001, E=0, N_S=1, NU_MATL=1, MATL_ID='C', HEAT_OF_REACTION=0 /
&MATL ID='C', DENSITY=1000.0, SPECIFIC_HEAT=1.0, CONDUCTIVITY=0.5, EMISSIVITY=0.0 /
&SURF ID='wall', MATL_ID='A', THICKNESS=0.001, STRETCH_FACTOR(1)=1, CELL_SIZE(1)=0.00050000000000000001, HEAT_TRANSFER_COEFFICIENT=0, BACKING='INSULATED' /
&VENT XB=-0.05,0.05,-0.05,0.05,0,0, SURF_ID='wall' /
&PROF XYZ=0,0,0, IOR=3, QUANTITY='TEMPERATURE', CELL_CENTERED=T, FORMAT_INDEX=2, ID='temperature' /
&DEVC ID='front', XYZ=0,0,0, IOR=3, QUANTITY='WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='back', XYZ=0,0,0, IOR=3, QUANTITY='BACK WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='mean', XYZ=0,0,0, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE', TIME_AVERAGED=F, DEPTH=0.0005 /
&DEVC ID='A', XYZ=0,0,0, IOR=3, QUANTITY='SOLID DENSITY', MATL_ID='A', DEPTH=0.0005, TIME_AVERAGED=F /
&DEVC ID='B', XYZ=0,0,0, IOR=3, QUANTITY='SOLID DENSITY', MATL_ID='B', DEPTH=0.0005, TIME_AVERAGED=F /
&DEVC ID='C', XYZ=0,0,0, IOR=3, QUANTITY='SOLID DENSITY', MATL_ID='C', DEPTH=0.0005, TIME_AVERAGED=F /
&TAIL /
