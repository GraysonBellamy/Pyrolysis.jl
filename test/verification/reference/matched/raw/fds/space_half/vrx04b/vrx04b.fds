&HEAD CHID='vrx04b', TITLE='Matched Pyrolysis.jl verification problem' /
&MESH IJK=3,3,3, XB=-0.15,0.15,-0.15,0.15,0,0.3 /
&TIME T_END=2000, DT=0.050000000000000003, WALL_INCREMENT=1 /
&MISC SOLID_PHASE_ONLY=T, TMPA=26.850000000000023 /
&RADI RADIATION=T /
&DUMP DT_DEVC=20, DT_PROF=2000 /
&MATL ID='A', DENSITY=1000.0, SPECIFIC_HEAT=1.0, CONDUCTIVITY=1.0, EMISSIVITY=0.85 /
&SURF ID='wall', MATL_ID='A', THICKNESS=0.005, STRETCH_FACTOR(1)=1, CELL_SIZE(1)=0.000125, HEAT_TRANSFER_COEFFICIENT=15.0, TMP_INNER=26.850000000000023, SKIP_INRAD=T, EXTERNAL_FLUX=23.988711977705883, BACKING='INSULATED' /
&VENT XB=-0.05,0.05,-0.05,0.05,0,0, SURF_ID='wall' /
&PROF XYZ=0,0,0, IOR=3, QUANTITY='TEMPERATURE', CELL_CENTERED=T, FORMAT_INDEX=2, ID='temperature' /
&DEVC ID='front', XYZ=0,0,0, IOR=3, QUANTITY='WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='back', XYZ=0,0,0, IOR=3, QUANTITY='BACK WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='mean', XYZ=0,0,0, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE', TIME_AVERAGED=F, DEPTH=0.0025 /
&TAIL /
