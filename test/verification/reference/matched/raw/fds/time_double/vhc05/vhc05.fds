&HEAD CHID='vhc05', TITLE='Matched Pyrolysis.jl verification problem' /
&MESH IJK=3,3,3, XB=-0.15,0.15,-0.15,0.15,0,0.3 /
&TIME T_END=5000, DT=2, WALL_INCREMENT=1 /
&MISC SOLID_PHASE_ONLY=T, TMPA=26.850000000000023 /
&RADI RADIATION=F /
&DUMP DT_DEVC=2500, DT_PROF=5000 /
&MATL ID='A', DENSITY=1000.0, SPECIFIC_HEAT=1.0, CONDUCTIVITY=0.5, EMISSIVITY=0.0, CONDUCTIVITY_RAMP='k' /
&RAMP ID='k', T=26.850000000000023, F=0.8 /
&RAMP ID='k', T=526.85, F=1.8 /
&SURF ID='wall', MATL_ID='A', THICKNESS=0.02, STRETCH_FACTOR(1)=1, CELL_SIZE(1)=0.00025000000000000001, HEAT_TRANSFER_COEFFICIENT=0, TMP_FRONT=526.85, TMP_BACK=26.850000000000023 /
&VENT XB=-0.05,0.05,-0.05,0.05,0,0, SURF_ID='wall' /
&PROF XYZ=0,0,0, IOR=3, QUANTITY='TEMPERATURE', CELL_CENTERED=T, FORMAT_INDEX=2, ID='temperature' /
&DEVC ID='front', XYZ=0,0,0, IOR=3, QUANTITY='WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='back', XYZ=0,0,0, IOR=3, QUANTITY='BACK WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='mean', XYZ=0,0,0, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE', TIME_AVERAGED=F, DEPTH=0.01 /
&TAIL /
