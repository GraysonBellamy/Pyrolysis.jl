&HEAD CHID='vhc02a', TITLE='Matched Pyrolysis.jl verification problem' /
&MESH IJK=3,3,3, XB=-0.15,0.15,-0.15,0.15,0,0.3 /
&TIME T_END=10000, DT=1, WALL_INCREMENT=1 /
&MISC SOLID_PHASE_ONLY=T, TMPA=26.850000000000023 /
&RADI RADIATION=F /
&DUMP DT_DEVC=1000, DT_PROF=1000 /
&MATL ID='A', DENSITY=1000.0, SPECIFIC_HEAT=1.0, CONDUCTIVITY=0.5, EMISSIVITY=0.0 /
&SURF ID='wall', MATL_ID='A', THICKNESS=0.1, STRETCH_FACTOR(1)=1, CELL_SIZE(1)=0.00125, HEAT_TRANSFER_COEFFICIENT=0.5, TMP_GAS_FRONT=226.85000000000002, BACKING='INSULATED' /
&VENT XB=-0.05,0.05,-0.05,0.05,0,0, SURF_ID='wall' /
&PROF XYZ=0,0,0, IOR=3, QUANTITY='TEMPERATURE', CELL_CENTERED=T, FORMAT_INDEX=1, ID='temperature' /
&DEVC ID='front', XYZ=0,0,0, IOR=3, QUANTITY='WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='back', XYZ=0,0,0, IOR=3, QUANTITY='BACK WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='mean', XYZ=0,0,0, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE', TIME_AVERAGED=F, DEPTH=0.05 /
&TAIL /
