&HEAD CHID='vhc01', TITLE='Matched Pyrolysis.jl verification problem' /
&MESH IJK=3,3,3, XB=-0.15,0.15,-0.15,0.15,0,0.3 /
&TIME T_END=180, DT=0.025000000000000001, WALL_INCREMENT=1 /
&MISC SOLID_PHASE_ONLY=T, TMPA=26.850000000000023 /
&RADI RADIATION=F /
&DUMP DT_DEVC=5, DT_PROF=5 /
&MATL ID='A', DENSITY=1000.0, SPECIFIC_HEAT=1.4, CONDUCTIVITY=0.2, EMISSIVITY=0.0 /
&SURF ID='wall', MATL_ID='A', THICKNESS=0.05, STRETCH_FACTOR(1)=1, CELL_SIZE(1)=0.0001, HEAT_TRANSFER_COEFFICIENT=20.0, TMP_GAS_FRONT=1276.85, BACKING='INSULATED' /
&VENT XB=-0.05,0.05,-0.05,0.05,0,0, SURF_ID='wall' /
&PROF XYZ=0,0,0, IOR=3, QUANTITY='TEMPERATURE', CELL_CENTERED=T, FORMAT_INDEX=1, ID='temperature' /
&DEVC ID='front', XYZ=0,0,0, IOR=3, QUANTITY='WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='back', XYZ=0,0,0, IOR=3, QUANTITY='BACK WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='mean', XYZ=0,0,0, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE', TIME_AVERAGED=F, DEPTH=0.025 /
&TAIL /
