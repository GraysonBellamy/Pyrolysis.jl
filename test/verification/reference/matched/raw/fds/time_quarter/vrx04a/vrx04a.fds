&HEAD CHID='vrx04a', TITLE='Matched Pyrolysis.jl verification problem' /
&MESH IJK=3,3,3, XB=-0.15,0.15,-0.15,0.15,0,0.3 /
&TIME T_END=8, DT=0.00050000000000000001, WALL_INCREMENT=1 /
&MISC SOLID_PHASE_ONLY=T, TMPA=26.850000000000023 /
&RADI RADIATION=T /
&DUMP DT_DEVC=0.10000000000000001, DT_PROF=8 /
&MATL ID='A', DENSITY=1000.0, SPECIFIC_HEAT=1.0, CONDUCTIVITY=100.0, EMISSIVITY=0.9 /
&SURF ID='wall', MATL_ID='A', THICKNESS=0.0001, STRETCH_FACTOR(1)=1, CELL_SIZE(1)=2.5000000000000001e-05, HEAT_TRANSFER_COEFFICIENT=0.0, TMP_INNER=626.85, SKIP_INRAD=T, EXTERNAL_FLUX=0.45930021300000007, BACKING='INSULATED' /
&VENT XB=-0.05,0.05,-0.05,0.05,0,0, SURF_ID='wall' /
&PROF XYZ=0,0,0, IOR=3, QUANTITY='TEMPERATURE', CELL_CENTERED=T, FORMAT_INDEX=2, ID='temperature' /
&DEVC ID='front', XYZ=0,0,0, IOR=3, QUANTITY='WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='back', XYZ=0,0,0, IOR=3, QUANTITY='BACK WALL TEMPERATURE', TIME_AVERAGED=F /
&DEVC ID='mean', XYZ=0,0,0, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE', TIME_AVERAGED=F, DEPTH=5e-05 /
&DEVC ID='cell_1', XYZ=0,0,0, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE', DEPTH=1.25e-05, TIME_AVERAGED=F /
&DEVC ID='cell_2', XYZ=0,0,0, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE', DEPTH=3.7500000000000003e-05, TIME_AVERAGED=F /
&DEVC ID='cell_3', XYZ=0,0,0, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE', DEPTH=6.25e-05, TIME_AVERAGED=F /
&DEVC ID='cell_4', XYZ=0,0,0, IOR=3, QUANTITY='INSIDE WALL TEMPERATURE', DEPTH=8.75e-05, TIME_AVERAGED=F /
&TAIL /
