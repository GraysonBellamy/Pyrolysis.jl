! Gpyro V2 matched comparison input vgt08a. run_comparisons.py sets DT0, NCELLZ(1)
! and TSTOP(1) per level; TSTOP is one step beyond the last observation.
&GPYRO_GENERAL
DT0=0.01, TAMB=300, TREF=300, P0=100000,
GX=0, GY=0, GZ=0, NTDMA_ITERATIONS=2000,
TMPTOL=1D-8, HTOL=1D-12, YITOL=1D-10, YJTOL=1D-10, PTOL=1D-8,
EPS_YIS=1D-12, EPS_YJG=1D-12,
SOLVE_PRESSURE=.TRUE., SOLVE_GAS_YJ=.FALSE.,
SOLVE_GAS_ENERGY=.FALSE., THERMAL_EQUILIBRIUM=.TRUE.,
CONVENTIONAL_RXN_ORDER=.TRUE., CONSTANT_DHVOL=.TRUE.,
SHYI_CORRECTION=.FALSE., SOLVER_DEFORMATION_MODE=1,
FULL_QSG=.FALSE., BLOWING=.FALSE., TORTUOSITY_FACTOR=1,
FIX_DOMAIN_TEMPERATURE=.TRUE.,
/

&GPYRO_OUTPUT
CASENAME='vgt08a', N_POINT_QUANTITIES=6, N_PROFILE_QUANTITIES=3,
DTDUMP_POINT=0.4999999, DTDUMP_PROFILE=0.4999999, DTMIN_KILL=1D-10,
POINT_QUANTITY(1)='TEMPERATURE', POINT_QUANTITY_INDEX(1)=0, POINT_Z(1)=0,
POINT_QUANTITY(2)='MLR', POINT_QUANTITY_INDEX(2)=0, POINT_Z(2)=0,
POINT_QUANTITY(3)='MASS_FLUX_TOTAL_Z', POINT_QUANTITY_INDEX(3)=0, POINT_Z(3)=0,
POINT_QUANTITY(4)='MASS_FLUX_TOTAL_Z', POINT_QUANTITY_INDEX(4)=0, POINT_Z(4)=0.1,
POINT_QUANTITY(5)='YJ', POINT_QUANTITY_INDEX(5)=1, POINT_Z(5)=0,
POINT_QUANTITY(6)='GAS_DENSITY', POINT_QUANTITY_INDEX(6)=0, POINT_Z(6)=0,
PROFILE_QUANTITY(1)='PRESSURE', PROFILE_QUANTITY_INDEX(1)=0, PROFILE_DIRECTION(1)='z', PROFILE_ISKIP(1)=1,
PROFILE_QUANTITY(2)='MASS_FLUX_TOTAL_Z', PROFILE_QUANTITY_INDEX(2)=0, PROFILE_DIRECTION(2)='z', PROFILE_ISKIP(2)=1,
PROFILE_QUANTITY(3)='D12', PROFILE_QUANTITY_INDEX(3)=0, PROFILE_DIRECTION(3)='z', PROFILE_ISKIP(3)=1,
/

&GPYRO_SPROPS
NSSPEC=1,
NAME(1)='matrix', R0(1)=400, RS0(1)=1000, C0(1)=1200, K0Z(1)=0.2, PERMZ(1)=5e-10, EMIS(1)=1,
/

&GPYRO_GPROPS
NGSPEC=1, IBG=1, IO2=1, CPG=1000,
NAME(1)='gas1', M(1)=29, SIGMA(1)=3.965473809316032, EPSOK(1)=100,
/

&GPYRO_RXNS
NRXNS=0,
/

&GPYRO_HGRXNS
NHGRXNS=0,
/

&GPYRO_GYIELDS

/

&GPYRO_HGYIELDS

/

&GPYRO_CASES
NCASES=1, IMESH(1)=1, TSTOP(1)=1.01, ZEROD(1)=.FALSE., BETA(1)=0,
/

&GPYRO_IC
NIC=1, TMP_INITIAL(1)=300, TMPG_INITIAL(1)=300, P_INITIAL(1)=100000.0, YI0(1,1)=1,
YJ0(1,1)=1,
/

&GPYRO_ALLBC
NSURF_IDX=2,
SURF_IDX(1)=1, QE(1)=0, HC(1)=0, RERADIATION(1)=.FALSE., TINF(1)=300, TINFG(1)=300, PRES(1)=100000.0, MDOTPP(1)=0, HM(1)=0,
YJINF(1,1)=1,
SURF_IDX(2)=2, QE(2)=0, HC(2)=0, RERADIATION(2)=.FALSE., TINF(2)=300, TINFG(2)=300, PRES(2)=-1, MDOTPP(2)=10000, HM(2)=0,
YJINF(2,1)=1,
/

&GPYRO_GEOM
NMESH=1, ZDIM(1)=0.1, NCELLZ(1)=81, NCELLX(1)=1, NCELLY(1)=1, HALF_CELLS_AT_BC(1)=.TRUE.,
DEFAULT_IC(1)=1, DEFAULT_SURF_IDX(1,5)=1, DEFAULT_SURF_IDX(1,6)=2,
/

